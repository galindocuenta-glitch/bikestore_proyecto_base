NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:8444
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=bs_bike_store
DB_SSL=false
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Administrador inicial: al arrancar la API se crea si ese correo aún no existe (no cambia uno existente).
# La clave debe tener entre 12 y 72 caracteres. Déjalas vacías para no crear ninguno.
ADMIN_NAME=Administrador BS
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=